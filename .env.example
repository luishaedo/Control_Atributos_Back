DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"
ADMIN_TOKEN="changeme"
PORT=4000
# Comma-separated list of allowed frontend origins (e.g. https://app.vercel.app)
CORS_ORIGIN="http://localhost:5173"
# Read response deadline (does not cancel database work or apply to mutations)
READ_TIMEOUT_MS=7000
# SELECT 1 readiness deadline; at most one underlying probe per process
READINESS_TIMEOUT_MS=2000
# Optional outside Render; Render uses RENDER_GIT_COMMIT automatically
APP_VERSION="local"
